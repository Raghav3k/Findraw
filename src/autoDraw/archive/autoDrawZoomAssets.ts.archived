export type AutoDrawStage = {
  label: string;
  recenter: number;
  revealHeight: number;
  revealWidth: number;
};

export type AutoDrawAsset = {
  aliases?: string[];
  answer: string;
  category: string;
  detailFocus: { x: number; y: number };
  difficulty: "Easy" | "Medium" | "Hard";
  id: string;
  imageUrl: string;
  subjectBounds: { x: number; y: number; width: number; height: number };
  stages: AutoDrawStage[];
};

