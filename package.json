{
  "name": "findraw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node server/index.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:cloudflare": "node scripts/run-cloudflare-build.mjs",
    "dev:cloudflare:backend": "cd cloudflare/backend && wrangler dev",
    "deploy:cloudflare:backend": "cd cloudflare/backend && wrangler deploy"
  },
  "dependencies": {
    "@excalidraw/laser-pointer": "1.3.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "perfect-freehand": "1.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^10.0.4",
    "typescript": "5.9.3",
    "vite": "5.0.12"
  },
  "packageManager": "pnpm@10.34.1"
}
