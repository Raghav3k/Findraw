{
  "name": "findraw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:production": "node scripts/check-channel-persistence.mjs && node scripts/check-room-lifecycle.mjs && node scripts/check-production-hardening.mjs && node scripts/check-live-connections.mjs && node scripts/check-drawing-deltas.mjs && node scripts/check-security.mjs && tsc --noEmit",
    "check:security": "node scripts/check-security.mjs",
    "dev": "concurrently -k -n server,web -c yellow,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node server/index.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:cloudflare": "node scripts/run-cloudflare-build.mjs",
    "dev:cloudflare:backend": "cd cloudflare/backend && wrangler dev",
    "deploy:cloudflare:backend": "cd cloudflare/backend && wrangler deploy"
  },
  "dependencies": {
    "@excalidraw/laser-pointer": "1.3.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "perfect-freehand": "1.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^10.0.4",
    "puppeteer": "^25.5.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "packageManager": "pnpm@10.34.1",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "nanoid@3": "^3.3.18"
    }
  }
}
